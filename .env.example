TAVILY_API_KEY=tvly-...
OPENROUTER_API_KEY=sk-or-...
# Liste de modèles séparés par des virgules, essayés dans l'ordre si 429/502/503.
# Termine toujours par un modèle payant (les gratuits OpenRouter changent régulièrement) :
OPENROUTER_MODELS=google/gemma-4-31b-it:free,openai/gpt-oss-20b:free,nvidia/nemotron-nano-9b-v2:free,openai/gpt-4o-mini
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=SandrineCipolla
GITHUB_REPO=sandrine-veille-techno

# Google Drive — optionnel (lancer scripts/auth-google.ts pour obtenir le refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Discord — optionnel (webhook du canal cible)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Cron optionnel — désactivé si absent
# Daily : lundi→jeudi 8h
CRON_DAILY=0 8 * * 1-4
# Weekly : vendredi 8h (récap de la semaine)
CRON_WEEKLY=0 8 * * 5
